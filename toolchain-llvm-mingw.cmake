set(CMAKE_SYSTEM_NAME Windows)

if (NOT CMAKE_SYSTEM_PROCESSOR)
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
endif()

if (CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
  set(TARGET_TRIPLE x86_64-w64-mingw32)
elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "i686")
  set(TARGET_TRIPLE i686-w64-mingw32)
elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
  set(TARGET_TRIPLE aarch64-w64-mingw32)
elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7")
  set(TARGET_TRIPLE armv7-w64-mingw32)
endif()

set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_RC_COMPILER llvm-windres)

set(CMAKE_C_COMPILER_TARGET ${TARGET_TRIPLE})
set(CMAKE_CXX_COMPILER_TARGET ${TARGET_TRIPLE})
set(CMAKE_RC_COMPILER_TARGET ${TARGET_TRIPLE})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_FLAGS "--target=${TARGET_TRIPLE}" CACHE INTERNAL "")
set(CMAKE_CXX_FLAGS "--target=${TARGET_TRIPLE}" CACHE INTERNAL "")
set(CMAKE_RC_FLAGS "--target=${TARGET_TRIPLE}" CACHE INTERNAL "")